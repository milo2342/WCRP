# Required Discord bot token
DISCORD_BOT_TOKEN=

# Discord Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Security note:
# Global moderation is hard-locked in index.js to guild 1418997681254174883.
# Primary security owner is hard-locked to user 939620924213309451.
# Additional OWNER_IDS do NOT receive security-owner access.

# Optional but recommended: permanent/main WCRP invite used when a provisional global ban is denied.
# If blank, the bot attempts to use the server vanity URL or create a one-use 7-day invite.
WCRP_INVITE_URL=
